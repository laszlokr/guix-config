# Guix build artefacts
target/
*.go
*.log

# Secrets — never commit
docker/.env
docker/**/.env
*.secret

# sing-box: only the credential-free template is tracked.  The real config
# holds a trojan password and a vmess UUID and belongs at
# /etc/sing-box/config.json (root:root, 0600), outside the world-readable store.
files/sing-box/config.json
files/sing-box/*.local.json

# Docker volume data
docker/**/volumes/

# OCA/Odoo addon repos cloned into the addons mount directory
docker/odoo/addons/*/
!docker/odoo/addons/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor
.dir-locals-2.el
*~
\#*\#
